# ==========================
# JobFlow
# ==========================
JOBFLOW_EMAIL=user@example.com
JOBFLOW_PASSWORD=your_password
DEFAULT_CV_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==========================
# Redis
# ==========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==========================
# Email (IMAP)
# ==========================
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
